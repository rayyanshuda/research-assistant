# Copy this file to your .env and fill it in with your real keys.

# Used by the agent loop (Claude tool-use)
ANTHROPIC_API_KEY=

EMBEDDING_PROVIDER=gemini

# Required if EMBEDDING_PROVIDER=gemini (default): you can get a free key at
# https://aistudio.google.com/apikey

# only needed if EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=

# Optional overrides
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
CHROMA_DIR=./data/chroma
CHROMA_COLLECTION=notes

# Max questions per ResearchAgent session before it stops calling the API
DEMO_MAX_QUESTIONS=5