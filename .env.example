# Copy this file to .env and fill in your real keys.
# Never commit the real .env file.

# Required: used by the agent loop (Claude tool-use)
ANTHROPIC_API_KEY=

# Which embedding backend to use: gemini (recommended for hosting), local, or openai.
# - gemini: needs GEMINI_API_KEY, genuine no-card free tier, works from a server
#           regardless of how many users hit it (no per-request local compute)
# - local:  free, no key needed, but runs the embedding model on your server's
#           own CPU per request — fine for solo/CLI use, not great once
#           multiple people are hitting a hosted instance concurrently
# - openai: needs OPENAI_API_KEY + billing/credits on the account
EMBEDDING_PROVIDER=gemini

# Required if EMBEDDING_PROVIDER=gemini (default) — get a free key at
# https://aistudio.google.com/apikey (no credit card required)

# Only needed if EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=

# Optional overrides
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
CHROMA_DIR=./data/chroma
CHROMA_COLLECTION=notes

# Max questions per ResearchAgent session before it stops calling the API
# (returns a friendly limit message instead) — keeps a demo visitor from
# running up unbounded cost. Set to 0 to disable the cap for local use.
DEMO_MAX_QUESTIONS=5